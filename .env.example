# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — Reference for Vercel & Production Deployments
#
# In Vercel: Project Settings → Environment Variables
# DO NOT commit real secrets in .env to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas (Required for comments, reviews, news sync, and live ratings) ──
# Get your connection string from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/appdb?retryWrites=true&w=majority

# Optional fallback MongoDB URI (e.g. secondary replica / backup cluster)
# REMOTE_MONGODB_URI=

# ── Cloudinary (Optional — for custom device image uploads) ───────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Public App URL (Used for canonical SEO URLs and sitemaps) ─────────────────
# Example: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
